{
  "appId": "com.aditya.schoolchat",
  "appName": "School Chat",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 150,
      "launchAutoHide": true,
      "backgroundColor": "#0f6fe8",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
