rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /statusMedia/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 15 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
