// Legacy Firebase Storage rules.
// School Chat 1.5 uploads chat attachments and image/video statuses through
// the native CatboxUploader path instead of Firebase Storage. Keep these
// rules restrictive if Storage is left enabled in the Firebase project.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
